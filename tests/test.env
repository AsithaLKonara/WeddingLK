# Test Environment Configuration
NODE_ENV=test

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/weddinglk_test
MONGODB_TEST_URI=mongodb://localhost:27017/weddinglk_test

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test-secret-key-for-testing-only

# Authentication (NextAuth.js) - Test credentials
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Email Configuration (Test)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test-user
SMTP_PASS=test-password

# Payment Gateway (Test)
STRIPE_PUBLISHABLE_KEY=pk_test_test
STRIPE_SECRET_KEY=sk_test_test
STRIPE_WEBHOOK_SECRET=whsec_test

# Cloudinary (Test)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# SMS Service (Test)
TWILIO_ACCOUNT_SID=test-account-sid
TWILIO_AUTH_TOKEN=test-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI Services (Test)
OPENAI_API_KEY=sk-test-openai-key
ANTHROPIC_API_KEY=sk-ant-test-key

# Analytics (Test)
GOOGLE_ANALYTICS_ID=GA_TEST_ID
MIXPANEL_TOKEN=test-mixpanel-token

# Feature Flags (Test)
ENABLE_AI_FEATURES=true
ENABLE_PAYMENTS=true
ENABLE_SMS=true
ENABLE_EMAIL=true

# Redis (Test)
REDIS_URL=redis://localhost:6379/1

# JWT (Test)
JWT_SECRET=test-jwt-secret-key

# API Keys (Test)
API_KEY=test-api-key
WEBHOOK_SECRET=test-webhook-secret

# External Services (Test)
GOOGLE_MAPS_API_KEY=test-google-maps-key
SENDGRID_API_KEY=test-sendgrid-key 