{
  "name": "weddinglk-next",
  "version": "1.0.0",
  "description": "A comprehensive wedding planning platform - Final Year University Project",
  "author": "Asitha Lakmal <asitha.lakmal@student.university.edu>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/asithalakmal/weddinglk-next.git"
  },
  "keywords": [
    "wedding",
    "planning",
    "platform",
    "nextjs",
    "react",
    "typescript",
    "university-project"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:api": "jest --testPathPattern=__tests__/api",
    "test:components": "jest --testPathPattern=__tests__/components",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "test:performance": "k6 run k6-load-test.js",
    "test:accessibility": "node scripts/accessibility-audit.js",
    "test:comprehensive": "node scripts/run-tests.js",
    "db:seed": "node scripts/seed-database.mjs",
    "db:reset": "node scripts/reset-database.mjs",
    "db:optimize": "node scripts/optimize-database.js",
    "docker:build": "docker build -f Dockerfile.production -t weddinglk:latest .",
    "docker:run": "docker run -p 3000:3000 weddinglk:latest",
    "docker:compose": "docker-compose -f docker-compose.production.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.production.yml down",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "audit:security": "npm audit",
    "audit:accessibility": "npm run test:accessibility",
    "audit:performance": "npm run test:performance",
    "audit:all": "npm run audit:security && npm run audit:accessibility && npm run audit:performance",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "build:analyze": "ANALYZE=true npm run build",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next coverage reports dist build",
    "setup:dev": "npm install && npm run db:seed",
    "setup:test": "npm install --include=dev && npm run test:coverage",
    "ci:test": "npm run lint && npm run type-check && npm run test:ci && npm run test:e2e",
    "ci:build": "npm run build && npm run build:analyze",
    "ci:deploy": "npm run ci:test && npm run ci:build && npm run deploy:production"
  },
