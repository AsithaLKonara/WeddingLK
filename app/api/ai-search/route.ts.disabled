import { NextRequest, NextResponse } from 'next/server'
import { getServerSession } from 'next-auth'
import { authOptions } from '@/lib/auth'
import { aiSearch, SearchQuery } from '@/lib/ai-search-enhancement'
import { connectToDatabase } from '@/lib/database'

// POST /api/ai-search - AI-powered search
export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    // Connect to database
    await connectToDatabase()

    const body = await request.json()
    const { query, searchType, filters, userPreferences, eventDetails } = body

    if (!query || !searchType) {
      return NextResponse.json({
        error: 'Query and search type are required'
      }, { status: 400 })
    }

    // Create search query
    const searchQuery: SearchQuery = {
      query,
      filters: {
        location: filters?.location || '',
        priceRange: filters?.priceRange || [0, 1000000],
        date: filters?.date || '',
        guestCount: filters?.guestCount || 100,
        category: searchType
      },
      userPreferences: {
        style: userPreferences?.style || '',
        budget: userPreferences?.budget || 500000,
        priority: userPreferences?.priority || 'quality'
      }
    }

    // Perform AI search
    const results = await aiSearch.search(searchQuery)

    return NextResponse.json({
      success: true,
      data: results,
      query,
      searchType,
      timestamp: new Date().toISOString()
    })

  } catch (error) {
    console.error('AI Search error:', error)
    return NextResponse.json(
      {
        success: false,
        error: 'AI search failed',
        message: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    )
  }
}

// GET /api/ai-search - Get search suggestions
export async function GET(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    // Connect to database
    await connectToDatabase()

    const { searchParams } = new URL(request.url)
    const query = searchParams.get('q')
    const type = searchParams.get('type')

    if (!query) {
      return NextResponse.json({
        error: 'Query parameter is required'
      }, { status: 400 })
    }

    const suggestions = aiSearch.getSearchSuggestions(query)

    return NextResponse.json({
      success: true,
      suggestions,
      query,
      type
    })

  } catch (error) {
    console.error('Search suggestions error:', error)
    return NextResponse.json(
      { error: 'Failed to get search suggestions' },
      { status: 500 }
    )
  }
} 