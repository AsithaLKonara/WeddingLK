    currency: 'LKR',
    status: 'pending',
    paymentMethod: 'eZ Cash',
    phoneNumber: data.phoneNumber,
    referenceId: `ez_${Date.now()}`
  }
}

async function processMCashPayment(data: any) {
  return {
    paymentId: `mc_${Date.now()}`,
    amount: data.amount,
    currency: 'LKR',
    status: 'pending',
    paymentMethod: 'mCash',
    phoneNumber: data.phoneNumber,
    referenceId: `mc_${Date.now()}`
  }
}

async function processBankTransferPayment(data: any) {
  return {
    paymentId: `bt_${Date.now()}`,
    amount: data.amount,
    currency: 'LKR',
    status: 'pending',
    paymentMethod: 'Bank Transfer',
    bankAccount: data.bankAccount,
    referenceNumber: `bt_${Date.now()}`
  }
}
