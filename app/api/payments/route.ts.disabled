import { NextRequest, NextResponse } from 'next/server'
import { getServerSession } from 'next-auth'
import { authOptions } from '@/lib/auth'

// POST /api/payments - Process payments
export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    const body = await request.json()
    const { type, amount, currency, description, paymentMethod } = body

    if (!type || !amount) {
      return NextResponse.json({ 
        error: 'Payment type and amount are required' 
      }, { status: 400 })
    }

    // Mock payment processing
    const paymentId = `pay_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`
    
    const paymentResult = {
      success: true,
      paymentId,
      status: 'pending',
      amount: parseFloat(amount),
      currency: currency || 'LKR',
      method: paymentMethod || 'card',
      description: description || 'WeddingLK Payment',
      timestamp: new Date().toISOString()
    }

    return NextResponse.json({
      success: true,
      data: paymentResult,
      type,
      message: 'Payment processed successfully'
    })

  } catch (error) {
    console.error('Payment processing error:', error)
    return NextResponse.json(
      {
        success: false,
        error: 'Payment processing failed',
        message: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    )
  }
}

// GET /api/payments - Get payment history
export async function GET(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    const { searchParams } = new URL(request.url)
    const type = searchParams.get('type')
    const limit = parseInt(searchParams.get('limit') || '10')

    // Mock payment history
    const mockPayments = [
      {
        id: 'pay_1',
        type: 'booking',
        amount: 50000,
        currency: 'LKR',
        status: 'completed',
        method: 'card',
        description: 'Venue booking payment',
        createdAt: new Date(Date.now() - 86400000).toISOString()
      },
      {
        id: 'pay_2',
        type: 'subscription',
        amount: 5000,
        currency: 'LKR',
        status: 'completed',
        method: 'payhere',
        description: 'Premium subscription',
        createdAt: new Date(Date.now() - 172800000).toISOString()
      },
      {
        id: 'pay_3',
        type: 'commission',
        amount: 2500,
        currency: 'LKR',
        status: 'pending',
        method: 'bank_transfer',
        description: 'Vendor commission',
        createdAt: new Date(Date.now() - 259200000).toISOString()
      }
    ]

    const filteredPayments = type 
      ? mockPayments.filter(payment => payment.type === type)
      : mockPayments

    return NextResponse.json({
      success: true,
      data: filteredPayments.slice(0, limit),
      total: filteredPayments.length
    })

  } catch (error) {
    console.error('Payment history error:', error)
    return NextResponse.json(
      {
        success: false,
        error: 'Failed to load payment history',
        message: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    )
  }
} 