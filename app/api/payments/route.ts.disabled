import { NextRequest, NextResponse } from 'next/server'
import { getServerSession } from 'next-auth'
import { authOptions } from '@/lib/auth'
import { PaymentGateway, PaymentRequest } from '@/lib/payment-gateway'
import { connectToDatabase } from '@/lib/database'

// POST /api/payments - Process payments
export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    // Connect to database
    await connectToDatabase()

    const body = await request.json()
    const { type, ...paymentData } = body

    if (!type) {
      return NextResponse.json({ error: 'Payment type is required' }, { status: 400 })
    }

    // Create payment request
    const paymentRequest: PaymentRequest = {
      amount: paymentData.amount || 0,
      currency: paymentData.currency || 'LKR',
      description: paymentData.description || 'WeddingLK Payment',
      customerEmail: session.user.email,
      customerName: paymentData.customerName || session.user.name || '',
      customerPhone: paymentData.customerPhone || '',
      metadata: {
        userId: session.user.id || '',
        type,
        ...paymentData.metadata
      },
      paymentMethod: paymentData.paymentMethod || 'payhere',
      returnUrl: paymentData.returnUrl || `${process.env.NEXT_PUBLIC_BASE_URL}/payment/success`,
      cancelUrl: paymentData.cancelUrl || `${process.env.NEXT_PUBLIC_BASE_URL}/payment/cancel`,
    }

    // Process payment
    const result = await PaymentGateway.processPayment(paymentRequest)

    if (!result.success) {
      return NextResponse.json({
        success: false,
        error: result.error || 'Payment processing failed'
      }, { status: 400 })
    }

    return NextResponse.json({
      success: true,
      data: result,
      type,
      timestamp: new Date().toISOString()
    })

  } catch (error) {
    console.error('Payment processing error:', error)
    return NextResponse.json(
      {
        success: false,
        error: 'Payment processing failed',
        message: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    )
  }
}

// GET /api/payments - Get payment history
export async function GET(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions)
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    // Connect to database
    await connectToDatabase()

    const { searchParams } = new URL(request.url)
    const type = searchParams.get('type')
    const limit = parseInt(searchParams.get('limit') || '10')

    // Mock payment history (in production, this would query the database)
    const mockPayments = [
      {
        id: 'pay_1',
        type: 'booking',
        amount: 50000,
        currency: 'LKR',
        status: 'completed',
        method: 'card',
        description: 'Venue booking payment',
        createdAt: new Date(Date.now() - 86400000).toISOString()
      },
      {
        id: 'pay_2',
        type: 'subscription',
        amount: 5000,
        currency: 'LKR',
        status: 'completed',
        method: 'payhere',
        description: 'Premium subscription',
        createdAt: new Date(Date.now() - 172800000).toISOString()
      },
      {
        id: 'pay_3',
        type: 'commission',
        amount: 2500,
        currency: 'LKR',
        status: 'pending',
        method: 'bank_transfer',
        description: 'Vendor commission',
        createdAt: new Date(Date.now() - 259200000).toISOString()
      }
    ]

    const filteredPayments = type 
      ? mockPayments.filter(payment => payment.type === type)
      : mockPayments

    return NextResponse.json({
      success: true,
      data: filteredPayments.slice(0, limit),
      total: filteredPayments.length
    })

  } catch (error) {
    console.error('Payment history error:', error)
    return NextResponse.json(
      {
        success: false,
        error: 'Failed to load payment history',
        message: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    )
  }
} 