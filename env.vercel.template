# Vercel Environment Configuration for WeddingLK
# IMPORTANT: Deploy FIRST to get your actual domain, then update these values

NODE_ENV=production

# Database Configuration (Use MongoDB Atlas for Vercel)
# Get these from MongoDB Atlas after creating cluster
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weddinglk?retryWrites=true&w=majority

# Redis Configuration (Use Upstash Redis - Vercel integration)
# Get this from Upstash after creating Redis database
REDIS_URL=redis://username:password@redis-server.upstash.io:6379

# Authentication - SECURE SECRETS (Generate new ones for Vercel)
# Generate these using: openssl rand -base64 32
NEXTAUTH_SECRET=your_vercel_nextauth_secret_here_generate_new_one
JWT_SECRET=your_vercel_jwt_secret_here_generate_new_one
ENCRYPTION_KEY=your_vercel_encryption_key_here_generate_new_one
SESSION_SECRET=your_vercel_session_secret_here_generate_new_one
COOKIE_SECRET=your_vercel_cookie_secret_here_generate_new_one

# OAuth Configuration (Update these AFTER deployment with real domain)
# Step 1: Deploy to Vercel to get your domain
# Step 2: Update OAuth redirect URIs in Google/Facebook consoles
# Step 3: Update NEXTAUTH_URL with your real domain
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# Google OAuth (Configure AFTER deployment)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth (Configure AFTER deployment)
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Email Configuration (Use external SMTP service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File Upload (Use external storage service)
UPLOAD_API_KEY=your_upload_api_key

# Application Settings
PORT=3000
HOSTNAME=0.0.0.0

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Development/Testing Flags (Disable in production)
DEBUG=false
LOG_LEVEL=info
ENABLE_MOCK_DATA=false
