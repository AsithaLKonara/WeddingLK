# Vercel Environment Configuration for WeddingLK
NODE_ENV=production

# Database Configuration (Use MongoDB Atlas for Vercel)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weddinglk?retryWrites=true&w=majority
REDIS_URL=redis://username:password@redis-server:6379

# Authentication - SECURE SECRETS (Generate new ones for Vercel)
NEXTAUTH_SECRET=your_vercel_nextauth_secret_here_generate_new_one
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# External Services (Configure these for production)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Email Configuration (Use external SMTP service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File Upload (Use external storage service)
UPLOAD_API_KEY=your_upload_api_key

# Application Settings
PORT=3000
HOSTNAME=0.0.0.0

# Additional Security Settings
JWT_SECRET=your_vercel_jwt_secret_here_generate_new_one
ENCRYPTION_KEY=your_vercel_encryption_key_here_generate_new_one

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_vercel_session_secret_here_generate_new_one
COOKIE_SECRET=your_vercel_cookie_secret_here_generate_new_one
