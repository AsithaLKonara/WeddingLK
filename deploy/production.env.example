# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/weddinglk_production
MONGODB_URI_CLOUD=mongodb+srv://username:password@cluster.mongodb.net/weddinglk_production

# NextAuth Configuration
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-super-secret-nextauth-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# OAuth Provider Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Instagram OAuth
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Payment Gateway Configuration
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayHere
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_SECRET_KEY=your-payhere-secret-key

# File Upload Configuration
# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration
# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key

# SMS Configuration
# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI Services Configuration
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Performance Monitoring
# Sentry
SENTRY_DSN=your-sentry-dsn

# Analytics
# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Security Configuration
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://yourdomain.com

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_METRICS=true
ENABLE_LOGGING=true

# Feature Flags
ENABLE_SOCIAL_AUTH=true
ENABLE_AI_FEATURES=true
ENABLE_VENUE_BOOSTING=true
ENABLE_ADVANCED_ANALYTICS=true

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,si,ta
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,LKR,EUR,GBP

# Mobile App Configuration
MOBILE_APP_ENABLED=true
MOBILE_APP_VERSION=1.0.0

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# SSL and Security
FORCE_HTTPS=true
SECURE_COOKIES=true
HSTS_MAX_AGE=31536000

# Database Performance
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Queue Configuration
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3 